---
import type { Profile } from '../content/schemas';
import type { NavItem } from '../lib/nav';
import LineageNav from './LineageNav.astro';
interface Props { profile: Profile; nav: NavItem[] }
const { profile, nav } = Astro.props;
---
<header class="identity" data-glow="0.8">
  <div class="identity__intro">
    <p class="identity__greeting">
      {profile.greeting.map((g, i) => (
        <span lang={g.lang}>{g.text}</span>
      ))}
    </p>
    <h1 class="identity__name">{profile.name}</h1>
    <p class="identity__headline">{profile.headline}</p>
    <p class="identity__pitch">{profile.pitch}</p>
    <p class="label">{profile.location}</p>
  </div>
  <LineageNav items={nav} />
  <div class="identity__actions">
    {profile.cv && <a class="btn btn--primary" href={profile.cv}>Download CV</a>}
    <a class="btn" href={profile.linkedin} rel="me">LinkedIn</a>
    <a class="btn" href={profile.github} rel="me">GitHub</a>
  </div>
  <a class="identity__email" href={`mailto:${profile.email}`}>{profile.email}</a>
</header>

<style>
  .identity {
    display: flex; flex-direction: column; gap: 32px; padding: 96px 0 64px;
  }
  .identity { position: relative; isolation: isolate; }
  .identity::before, .identity::after {
    content: ''; position: absolute; inset: 0; pointer-events: none; z-index: -1; background-size: 22px 22px;
  }
  .identity::before { background-image: radial-gradient(color-mix(in srgb, var(--line) 70%, transparent) 1px, transparent 1.4px); }
  /* The column no longer reaches the page edge, so the grid fades out at both sides instead of stopping on a line. */
  .identity::before {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 75%, transparent);
            mask-image: linear-gradient(to right, transparent, #000 12%, #000 75%, transparent);
  }
  .identity::after {
    background-image: radial-gradient(color-mix(in srgb, var(--accent) 42%, var(--bg)) 1.2px, transparent 1.6px);
    -webkit-mask-image: radial-gradient(130px circle at var(--mx, -999px) var(--my, -999px), #000 0%, rgb(0 0 0 / 0.35) 40%, transparent 75%);
            mask-image: radial-gradient(130px circle at var(--mx, -999px) var(--my, -999px), #000 0%, rgb(0 0 0 / 0.35) 40%, transparent 75%);
    opacity: var(--glow, 0); transition: opacity 0.4s ease;
  }
  @media (max-width: 1024px) { .identity::before, .identity::after { content: none; } }
  .identity__intro { display: flex; flex-direction: column; gap: 12px; }
  .identity__greeting {
    /* CJK words fall back to the visitor's system fonts (picked per word by its lang attribute). Web fonts for three
       words cost ~300 KB of render-blocking CSS. */
    font-size: 14px; color: var(--faint);
  }
  .identity__greeting { display: flex; flex-wrap: wrap; gap: 2px 14px; }
  /* Keep each greeting word whole: the body allows breaking anywhere, which split 안녕하세요. */
  .identity__greeting [lang] { white-space: nowrap; }
  .identity__name { font-size: clamp(40px, 5vw, 56px); font-weight: 800; line-height: 1; letter-spacing: -0.03em; }
  .identity__headline { font-size: 19px; font-weight: 600; color: var(--accent); }
  .identity__pitch { font-size: 16px; color: var(--muted); max-width: 46ch; }
  .identity__actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .identity__email { display: inline-flex; align-items: center; min-height: 44px; width: fit-content; font-size: 15px; color: var(--muted); }
  @media (min-width: 1025px) {
    /* Spacing shrinks with the window height, so the column compacts (e.g. when zoomed in) instead of overflowing. */
    .identity { gap: clamp(14px, 3.5vh, 32px); padding: clamp(32px, 11vh, 96px) 0 clamp(24px, 7vh, 64px); }
    .identity__intro { gap: clamp(6px, 1.4vh, 12px); }
  }
  /* Pinned only while the compact column fits the window; otherwise it scrolls with the page, never on its own. */
  @media (min-width: 1025px) and (min-height: 640px) {
    .identity { position: sticky; top: 0; height: 100vh; }
  }
  @media (max-width: 1024px) {
    .identity { gap: 24px; padding: 56px 0 0; }
  }
</style>
