---
import type { Profile } from '../content/schemas';
interface Props { steps: Profile['whatIBuild'] }
const { steps } = Astro.props;
const hubIndex = Math.max(0, steps.findIndex((s) => s.hub));
---
<div class="flow" data-flow="strip" data-change-index={hubIndex}>
  <ol class="flow__list">
    {steps.map((step, i) => (
      <li class="flow__step">
        {i > 0 && <span class="flow__arrow" aria-hidden="true">──▶</span>}
        <span class="flow__node">
          <span class:list={['flow__label', { 'flow__label--hub': step.hub }]}>{step.label}</span>
          <span class="flow__caption">{step.caption}</span>
        </span>
      </li>
    ))}
  </ol>
</div>

<style>
  .flow { position: relative; padding-block: 8px; container-type: inline-size; }
  .flow__list { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 12px 10px; margin: 0; padding: 0; list-style: none; }
  .flow__step { display: flex; align-items: flex-start; gap: 10px; }
  .flow__arrow { font-family: 'Chivo Mono', ui-monospace, monospace; font-size: 13px; color: var(--faint); padding-top: 9px; }
  .flow__node { display: flex; flex-direction: column; gap: 8px; }
  .flow__label {
    padding: 8px 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg);
    font-size: 14px; font-weight: 600; color: var(--fg);
  }
  .flow__label--hub { border-color: var(--accent); color: var(--accent); }
  .flow__caption { font-family: 'Chivo Mono', ui-monospace, monospace; font-size: 11px; color: var(--faint); padding-left: 2px; }
  /* Particles already show the direction, so the arrows step back to a faint guide while they run. */
  .flow:has(:global(.flow-canvas)) .flow__arrow { opacity: 0.35; }
  /* Too narrow for one row: wrapping put an arrow at the start of a line and sent particles through a caption.
     Stack the steps instead, with fixed-width labels so the particle path runs straight down their centres. */
  @container (max-width: 560px) {
    .flow__list, .flow__step { flex-direction: column; gap: 0; }
    .flow__step { align-items: flex-start; }
    .flow__arrow { position: relative; width: 9.5rem; height: 24px; padding: 0; font-size: 0; color: var(--faint); }
    .flow__arrow::before {
      content: ''; position: absolute; left: 50%; top: 3px; bottom: 8px; width: 1px; background: currentColor;
    }
    .flow__arrow::after {
      content: ''; position: absolute; left: 50%; bottom: 3px; transform: translateX(-50%);
      border: 4px solid transparent; border-bottom: 0; border-top: 6px solid currentColor;
    }
    .flow__node { flex-direction: row; align-items: center; gap: 14px; }
    .flow__label { width: 9.5rem; flex-shrink: 0; text-align: center; }
    .flow__caption { min-width: 0; padding-left: 0; }
  }
</style>
