---
import type { Profile } from '../content/schemas';
interface Props { steps: Profile['whatIBuild'] }
const { steps } = Astro.props;
const hubIndex = Math.max(0, steps.findIndex((s) => s.hub));
---
<div class="flow" data-flow="strip" data-change-index={hubIndex}>
  <ol class="flow__list">
    {steps.map((step, i) => (
      <li class="flow__step">
        {i > 0 && <span class="flow__arrow" aria-hidden="true">──▶</span>}
        <span class="flow__node">
          <span class:list={['flow__label', { 'flow__label--hub': step.hub }]}>{step.label}</span>
          <span class="flow__caption">{step.caption}</span>
        </span>
      </li>
    ))}
  </ol>
</div>

<style>
  .flow { position: relative; padding-block: 8px; }
  .flow__list { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 12px 10px; margin: 0; padding: 0; list-style: none; }
  .flow__step { display: flex; align-items: flex-start; gap: 10px; }
  /* Arrows are drawn, not typed, so they look the same in every font. The ──▶ text is the no-CSS fallback. */
  .flow__arrow { position: relative; width: 28px; height: 38px; font-size: 0; color: var(--faint); }
  .flow__arrow::before { content: ''; position: absolute; left: 0; right: 6px; top: 50%; height: 1px; background: currentColor; }
  .flow__arrow::after {
    content: ''; position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    border: 4px solid transparent; border-right: 0; border-left: 6px solid currentColor;
  }
  .flow__node { display: flex; flex-direction: column; gap: 8px; }
  .flow__label {
    padding: 8px 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg);
    font-size: 14px; font-weight: 600; color: var(--fg);
  }
  .flow__label--hub { border-color: var(--accent); color: var(--accent); }
  .flow__caption { font-size: 12px; color: var(--faint); padding-left: 2px; }
  /* Particles already show the direction, so the arrows step back to a faint guide while they run. */
  .flow:has(:global(.flow-canvas)) .flow__arrow { opacity: 0.35; }
  /* Narrower desktop windows, where the content column is under about 560px: tighten the row so it still fits on one
     line. A media query rather than a container query, so the strip keeps its natural width for the heading above it. */
  @media (min-width: 1025px) and (max-width: 1218px) {
    .flow__list { gap: 12px 6px; }
    .flow__step { gap: 6px; }
    .flow__arrow { width: 20px; }
    .flow__label { padding: 8px 10px; font-size: 13px; }
  }
</style>
