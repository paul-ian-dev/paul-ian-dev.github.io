---
import type { Profile } from '../content/schemas';
interface Props { stack: Profile['stack'] }
const { stack } = Astro.props;
const tiers = [
  ['At work', stack.work],
  ['In projects', stack.projects],
  ['Learning', stack.learning],
] as const;
---
<section id="stack" class="stack" aria-labelledby="stack-heading">
  <h2 id="stack-heading" class="label">Stack</h2>
  <dl class="stack__list">
    {tiers.filter(([, items]) => items.length > 0).map(([label, items]) => (
      <div class="stack__tier">
        <dt>{label}</dt>
        <dd>{items.join(' · ')}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .stack { display: flex; flex-direction: column; gap: 20px; }
  .stack__list { display: flex; flex-direction: column; gap: 14px; margin: 0; }
  .stack__tier { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 16px; }
  .stack__tier dt { font-family: 'Chivo Mono', ui-monospace, monospace; font-size: 12px; color: var(--accent); padding-top: 3px; }
  .stack__tier dd { margin: 0; font-size: 15px; color: var(--muted); }
  @media (max-width: 640px) { .stack__tier { grid-template-columns: minmax(0, 1fr); gap: 4px; } }
</style>
