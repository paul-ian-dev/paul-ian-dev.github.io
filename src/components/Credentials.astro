---
import type { CollectionEntry } from 'astro:content';
interface Props { credentials: CollectionEntry<'credentials'>[] }
const { credentials } = Astro.props;
---
<section id="credentials" class="creds" aria-labelledby="credentials-heading">
  <h2 id="credentials-heading" class="label">Credentials</h2>
  <ul class="creds__grid">
    {credentials.map(({ data }) => (
      <li class="cred">
        <p class="cred__name">{data.name}</p>
        <p class="cred__meta mono">{[data.issuer, data.detail, data.year].filter(Boolean).join(' · ')}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .creds { display: flex; flex-direction: column; gap: 24px; }
  .creds__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 40px; margin: 0; padding: 0; list-style: none; }
  .cred { display: flex; flex-direction: column; gap: 4px; }
  .cred__name { font-size: 15px; font-weight: 600; }
  .cred__meta { font-size: 12px; color: var(--faint); }
  @media (max-width: 640px) { .creds__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
