---
import type { CollectionEntry } from 'astro:content';
// showYear: degrees and certifications date quickly; awards don't, so their section leaves the year out.
interface Props { id: string; heading: string; credentials: CollectionEntry<'credentials'>[]; showYear?: boolean }
const { id, heading, credentials, showYear = true } = Astro.props;
---
{credentials.length > 0 && (
<section id={id} class="creds" aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`} class="label">{heading}</h2>
  <ul class="creds__grid">
    {credentials.map(({ data }) => (
      <li class="cred">
        <p class="cred__name">
          {data.name.split(/(\([^)]*\))/).map((part) => (part.startsWith('(') ? <span class="cred__nowrap">{part}</span> : part))}
        </p>
        <p class="cred__meta">{[data.issuer, data.detail, showYear && data.year].filter(Boolean).join(', ')}</p>
      </li>
    ))}
  </ul>
</section>
)}

<style>
  .creds { display: flex; flex-direction: column; gap: 24px; }
  .creds__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 40px; margin: 0; padding: 0; list-style: none; }
  .cred { display: flex; flex-direction: column; gap: 4px; }
  /* Line breaks typed in the CMS are kept; bracketed codes like (MS-900) never split. */
  .cred__name { font-size: 15px; font-weight: 600; white-space: pre-line; }
  .cred__nowrap { white-space: nowrap; }
  .cred__meta { font-size: 13px; color: var(--faint); }
  @media (max-width: 640px) { .creds__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
