---
import type { Profile } from '../content/schemas';
import FlowStrip from './FlowStrip.astro';
import { parseLinks } from '../lib/links';
interface Props { profile: Profile }
const { profile } = Astro.props;
---
<section id="about" class="about" aria-labelledby="about-heading">
  <h2 id="about-heading" class="visually-hidden">About</h2>
  <div class="about__build">
    <div class="about__head">
      <p class="label about__label">What I build</p>
      <a class="about__more" href="/how-i-build/">See how it fits together →</a>
    </div>
    <div class="about__strip"><FlowStrip steps={profile.whatIBuild} /></div>
  </div>
  {profile.about.map((para) => (
    <p class="about__para">
      {parseLinks(para).map((s) => (typeof s === 'string' ? s : <a href={s.href} rel="noopener">{s.text}</a>))}
    </p>
  ))}
</section>

<style>
  .about { display: flex; flex-direction: column; gap: 22px; max-width: 64ch; }
  .about__build { display: flex; flex-direction: column; gap: 12px; margin-bottom: 8px; }
  /* Section label on the left, its "more" link on the right, sharing one baseline. */
  .about__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; }
  .about__more { font-size: 13px; font-weight: 600; color: var(--accent); text-decoration: none; }
  .about__more:hover { text-decoration: underline; }
  .about__para { font-size: 17px; line-height: 1.7; color: var(--muted); }
  /* On phones the strip only repeats the pitch and pushes the About text below the fold. */
  /* The link stays so the pipeline page is still reachable. */
  @media (max-width: 640px) { .about__label, .about__strip { display: none; } .about__build { margin-bottom: 0; } }
</style>
