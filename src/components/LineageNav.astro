---
import type { NavItem } from '../lib/nav';
interface Props { items: NavItem[] }
const { items } = Astro.props;
---
<nav class="lineage" aria-label="Sections" data-flow="lineage">
  {items.map((item, i) => (
    <a class:list={['lineage__item', { 'is-active': i === 0 }]} href={`#${item.id}`} aria-current={i === 0 ? 'true' : undefined}>
      <span class="lineage__dot" aria-hidden="true"></span>
      <span class="lineage__label">{item.label}</span>
      {item.count !== undefined && <span class="lineage__count">{item.count}</span>}
    </a>
  ))}
</nav>

<style>
  .lineage { position: relative; display: flex; flex-direction: column; gap: 10px; }
  .lineage::before {
    content: ''; position: absolute; left: 9px; top: 22px; bottom: 22px; width: 2px; background: var(--line);
  }
  .lineage__item {
    position: relative; z-index: 1; display: flex; align-items: center; gap: 18px; min-height: 44px;
    font-size: 12px; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--faint); text-decoration: none;
  }
  .lineage__dot {
    flex-shrink: 0; width: 12px; height: 12px; margin: 0 2px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--faint);
  }
  .lineage__count { font-size: 11px; font-variant-numeric: tabular-nums; color: var(--faint); opacity: 0.8; }
  .lineage__item.is-active { color: var(--fg); }
  .lineage__item.is-active .lineage__dot {
    width: 16px; height: 16px; margin: 0; background: var(--accent); border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--bg), 0 0 0 5px var(--accent);
  }
  @media (max-width: 1024px) {
    .lineage {
      position: sticky; top: 0; z-index: 20; flex-direction: row; gap: 18px; overflow-x: auto;
      margin-inline: -16px; padding: 4px 16px; background: var(--bg); border-bottom: 1px solid var(--line);
      scrollbar-width: none;
    }
    .lineage::before { left: 24px; right: 24px; top: 50%; bottom: auto; width: auto; height: 2px; }
    .lineage__item { gap: 10px; flex-shrink: 0; }
    .lineage__label, .lineage__item { background: var(--bg); padding-right: 4px; }
  }
</style>
