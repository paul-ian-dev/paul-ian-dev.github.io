---
import type { NavItem } from '../lib/nav';
interface Props { items: NavItem[] }
const { items } = Astro.props;
---
<nav class="lineage" aria-label="Sections">
  {items.map((item, i) => (
    <a class:list={['lineage__item', { 'is-active': i === 0 }]} href={`#${item.id}`} aria-current={i === 0 ? 'true' : undefined}>
      <span class="lineage__line" aria-hidden="true"></span>
      <span class="lineage__label">{item.label}</span>
    </a>
  ))}
</nav>

<style>
  .lineage { display: flex; flex-direction: column; }
  .lineage__item {
    display: flex; align-items: center; gap: 16px; min-height: clamp(32px, 5vh, 44px); width: fit-content;
    font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--faint); text-decoration: none;
  }
  .lineage__line { width: 32px; height: 1px; background: currentColor; transition: width 0.2s ease; }
  .lineage__item:hover, .lineage__item.is-active { color: var(--fg); }
  .lineage__item:hover .lineage__line, .lineage__item.is-active .lineage__line { width: 64px; }
  @media (prefers-reduced-motion: reduce) { .lineage__line { transition: none; } }
  /* On one-column screens the page is short enough to scroll; section headings stick instead (see index.astro). */
  @media (max-width: 1024px) { .lineage { display: none; } }
</style>
