---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { earlierMeta } from '../lib/format';
interface Props { featured: CollectionEntry<'projects'>[]; earlier: CollectionEntry<'projects'>[] }
const { featured, earlier } = Astro.props;
---
{(featured.length > 0 || earlier.length > 0) && (
  <section id="work" class="work" aria-labelledby="work-heading">
    <h2 id="work-heading" class="label">Projects</h2>
    {featured.map((p) => <ProjectCard project={p} />)}
    {earlier.length > 0 && (
      <div class="work__earlier">
        <h3 class="work__earlier-label">Earlier projects</h3>
        <ul>
          {earlier.map((p) => {
            const href = p.data.repoUrl ?? p.data.liveUrl;
            const onGitHub = Boolean(href && new URL(href).hostname === 'github.com');
            return (
              <li class="work__earlier-item">
                {onGitHub && (
                  <svg class="work__gh" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
                  </svg>
                )}
                <span>
                  {href ? <a href={href} rel="noopener">{p.data.title}{onGitHub && <span class="visually-hidden"> on GitHub</span>}</a> : p.data.title}
                  {' '}{earlierMeta(p.data)}
                </span>
              </li>
            );
          })}
        </ul>
      </div>
    )}
  </section>
)}

<style>
  .work { display: flex; flex-direction: column; gap: 12px; }
  .work__earlier { margin-top: 12px; font-size: 14px; color: var(--muted); }
  .work__earlier-label { font-size: 14px; font-weight: 600; color: var(--fg); margin-bottom: 4px; }
  .work__earlier ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .work__earlier-item { display: flex; align-items: baseline; gap: 8px; }
  /* GitHub mark for projects whose link goes to their repository. */
  .work__gh { flex-shrink: 0; align-self: center; color: var(--faint); }
  .work__earlier-item:hover .work__gh { color: var(--accent); }
</style>
