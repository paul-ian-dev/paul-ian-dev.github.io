---
interface Props { email: string }
const { email } = Astro.props;
---
<div class="copy-email">
  <span id="email-address">{email}</span>
  <button type="button" class="copy-email__btn" data-copy={email} aria-controls="email-address" aria-label="Copy email address" hidden>Copy</button>
  <span class="visually-hidden" role="status" data-copy-status></span>
</div>

<style>
  .copy-email { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 14px; color: var(--muted); }
  .copy-email__btn {
    min-height: 44px; min-width: 44px; padding: 0 12px; border-radius: 6px; border: 1px solid var(--line);
    background: transparent; color: var(--fg); font: 600 13px 'Chivo', system-ui, sans-serif; cursor: pointer;
  }
</style>
