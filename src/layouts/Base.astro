---
import '@fontsource/chivo/400.css';
import '@fontsource/chivo/500.css';
import '@fontsource/chivo/600.css';
import '@fontsource/chivo/800.css';
import '../styles/base.css';
import { tokensCss, dark, light } from '../styles/tokens';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}
const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={dark.bg} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={light.bg} media="(prefers-color-scheme: light)" />
    <style is:inline set:html={tokensCss()}></style>
    <script is:inline>
      // Runs before first paint so a chosen theme never flashes the other one.
      (() => {
        let t;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
        // Lets pages hide no-JS fallbacks until their script has run.
        document.documentElement.classList.add('js');
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="backdrop" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <ThemeToggle />
    <slot />
    <script>
      import { initGlow } from '../scripts/glow';
      initGlow();
    </script>
  </body>
</html>
